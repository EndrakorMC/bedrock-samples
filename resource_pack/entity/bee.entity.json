{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:bee",
      "materials": {
        "default": "bee"
      },
      "textures": {
        "default": "textures/entity/bee/bee",
        "angry": "textures/entity/bee/bee_angry",
        "nectar": "textures/entity/bee/bee_nectar",
        "angry_nectar": "textures/entity/bee/bee_angry_nectar"
      },
      "geometry": {
        "default": "geometry.bee"
      },
      "animations": {
        "flying": "animation.bee.flying",
        "drip": "controller.animation.bee.drip",
        "controller_bee_sting": "controller.animation.bee.sting",
        "bee_sting": "animation.bee.sting",
        "bee_no_stinger": "animation.bee.no_stinger",
        "bee_fly_bobbing": "animation.bee.fly.bobbing",
        "bee_root_controller": "controller.animation.bee.root"
      },
      "particle_effects": {
        "nectar_dripping": "minecraft:nectar_drip_particle"
      },
      "scripts": {
        "animate": [
          "bee_root_controller",
          {
            "bee_no_stinger": "query.mark_variant == 1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.bee"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_bee"
      }
    }
  }
}
{
  "format_version": "1.10",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:random_bee",
      "spawn_egg": "minecraft:bee_spawn_egg",
      "is_spawnable": true
    },
    "components": {
      "minecraft:geometry": "geometry.random_bee",
      "minecraft:behavior": {
        "minecraft:interact": {
          "on_interact": {
            "type": "tame",
            "with_item": "minecraft:honey_bottle",
            "success_message": "You tamed a random bee!"
          }
        },
        "minecraft:spawn": {
          "type": "random",
          "choices": [
            {
              "type": "minecraft:bee_a",
              "weight": 50
            },
            {
              "type": "minecraft:bee_b",
              "weight": 50
            }
          ]
        }
      }
    }
  }
}
{
  "format_version": "1.10",
  "minecraft:geometry": {
    "description": {
      "identifier": "geometry.bee_b",
      "texture": "textures/entities/bee_b"
    },
    "bones": [
      {
        "name": "bee_b_body",
        "pivot": [0.0, 0.0, 0.0],
        "cubes": [
          {
            "origin": [-0.5, 0.0, -0.5],
            "size": [1.0, 1.0, 1.0],
            "uv": [0, 0]
          }
        ]
      }
    ]
  }
}
